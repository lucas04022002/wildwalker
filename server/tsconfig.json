{
  "compilerOptions": {
    /* Langage et environnement */
    "target": "esnext",
    "lib": ["esnext"],

    /* Modules : CommonJS, comme le code existant (__dirname, require.main) */
    "module": "commonjs",
    "moduleResolution": "node10",
    "esModuleInterop": true,
    "resolveJsonModule": true,

    /* Émission : dist/src/main.js et dist/bin/migrate.js */
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "noEmitOnError": true,

    /* Vérifications */
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src", "bin", "database"],
  "exclude": ["node_modules", "dist", "tests"]
}
