# .env.sample — variables d'environnement du serveur (copier en .env)

# Application
APP_PORT=3310
# NODE_ENV=production en déploiement ; laissé vide en local
NODE_ENV=development

# Base de données
DB_HOST=localhost
DB_PORT=3306
DB_USER=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_NAME=YOUR_DATABASE_NAME

# Autorise `npm run db:seed` quand NODE_ENV=production.
# À ne positionner à 1 que le temps de charger les données de démonstration.
ALLOW_SEED=

# Authentification par jeton (cookie ww_session, signé HS256, 7 jours).
# Obligatoire : le serveur refuse de démarrer sans.
JWT_SECRET=remplace_par_une_longue_chaine_aleatoire

# Attribut Secure du cookie de session ww_session.
# Vide = le bon défaut : Secure dès que NODE_ENV=production.
# COOKIE_SECURE=0 le désarme ; à NE JAMAIS POSER EN PRODUCTION (le cookie de
# session voyagerait alors en clair). Seule la CI s'en sert, le temps d'un
# smoke test qui parle en HTTP simple contre l'image.
COOKIE_SECURE=

# URL du client : origine CORS, et origine de référence de la garde anti-CSRF.
# Obligatoire : le serveur refuse de démarrer sans.
CLIENT_URL=http://localhost:3000

# Paiement Stripe
STRIPE_SECRET_KEY=your secret key stripe
