{
  "name": "@wildwalker/server",
  "description": "API Express/MySQL de WildWalker (auth, panier, réservations, paiement Stripe, tableaux de bord).",
  "author": "Équipe WildWalker — Wild Code School (maintainer: Lucas Guilhot)",
  "license": "MIT",
  "scripts": {
    "build": "tsc && node scripts/copy-sql.mjs",
    "check-types": "tsc --noEmit",
    "db:migrate": "tsx ./bin/migrate",
    "db:seed": "tsx ./bin/seed",
    "dev": "tsx watch --clear-screen=false ./src/main",
    "start": "node dist/src/main.js",
    "test": "jest --verbose"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
    "multer": "^2.3.0",
    "mysql2": "^3.24.4",
    "stripe": "^22.2.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/joi": "^17.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
