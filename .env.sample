# .env.sample — variables lues par docker-compose.yml (copier en .env).
#
# Ce fichier ne sert QU'À la pile Docker locale. Pour lancer l'application
# sans Docker, ce sont server/.env et client/.env qu'il faut remplir
# (voir server/.env.sample et client/.env.sample).
#
# Le .env réel n'est jamais versionné (voir .gitignore).

# Obligatoire : sans lui, `docker compose up` refuse de démarrer.
# Une longue chaîne aléatoire, par exemple : openssl rand -hex 32
JWT_SECRET=

# Base de données (le conteneur MySQL est créé avec ces valeurs).
DB_NAME=wildwalker
DB_USER=wildwalker
DB_PASSWORD=wildwalker
MYSQL_ROOT_PASSWORD=rootwildwalker

# Origine publique de l'application. En local, l'application se sert
# elle-même : client et API partagent http://localhost:3310.
CLIENT_URL=http://localhost:3310

# Stripe. La clé publique est inlinée dans le client à la construction de
# l'image, la clé secrète est lue par le serveur au démarrage.
VITE_STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
