# .env.sample - Sample Environment Variables for Client (Vite)

# Server API URL (call it in React with import.meta.env.VITE_API_URL)
# La session est un cookie httpOnly : cette URL doit être exactement celle que
# le serveur autorise en CORS, et le serveur doit connaître l'URL du client
# (CLIENT_URL dans server/.env). Sinon le cookie ne part pas avec les requêtes.
VITE_API_URL=http://localhost:3310

VITE_STRIPE_PUBLIC_KEY=your public key stripe
# Other Environment Variables (if needed)
# VITE_OTHER_VARIABLE=value
